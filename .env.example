# Environment Configuration Template
# Copy this file to .env and fill in with your actual credentials

# ============================================================================
# APPLICATION URLs
# ============================================================================

# Base URL for Vantage Dashboard staging environment
BASE_URL=https://vantagedashboard-stg.bcg.com/

# API base URL for direct endpoint calls
API_BASE_URL=https://api.vantagedashboard-stg.bcg.com

# ============================================================================
# OKTA AUTHENTICATION
# ============================================================================

# Okta test account username (email)
# Used by auth.setup.ts for manual login via browser
OKTA_USERNAME=your.email@bcg.com

# Okta test account password
# Used by auth.setup.ts for manual login via browser
OKTA_PASSWORD=your-password

# ============================================================================
# API CREDENTIALS
# ============================================================================

# Bearer token (Okta JWT)
# Auto-populated by `npm run auth` — extracts from Okta session
# If empty or expired, `npm run auth` will refresh it
# Note: This is the same JWT stored in storageSession.json
BEARER_TOKEN=

# API key for direct API calls
# Required for endpoints that check x-api-key header
X_API_KEY=your-api-key

# ============================================================================
# LOGGING & DEBUG
# ============================================================================

# Log level: debug | info | warn | error
# Default: info
# debug   = verbose logging (all levels)
# info    = standard operational logging
# warn    = warnings and errors only
# error   = errors only
LOG_LEVEL=info

# ============================================================================
# BROWSER & EXECUTION
# ============================================================================

# Run browser in headed mode (show window)
# 1 = headed (show window), 0 or unset = headless
# Ignored in CI (always headless on GitHub Actions)
HEADED=0

# Slow down browser actions (milliseconds)
# Useful for debugging flaky tests locally
# 0 = no delay
SLOW_MO=0

# Force headless mode even locally
# 1 = headless, 0 or unset = use HEADED env var
HEADLESS=0

# ============================================================================
# CI/CD (Automatically Set in GitHub Actions)
# ============================================================================

# CI environment indicator
# Set automatically by GitHub Actions
# Disables headed browser, enables retries, uses different auth strategy
# Uncomment locally to simulate CI behavior
# CI=true
